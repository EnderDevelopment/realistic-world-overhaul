{
  "format_version": "1.21.0",
  "minecraft:entity": {
    "description": {
      "identifier": "realism:deer",
      "is_spawnable": true,
      "is_summonable": true,
      "is_experimental": false
    },
    "components": {
      "minecraft:type_family": { "family": ["realism", "deer", "mob"] },
      "minecraft:collision_box": { "width": 0.9, "height": 1.4 },
      "minecraft:health": { "value": 12, "max": 12 },
      "minecraft:movement": { "value": 0.32 },
      "minecraft:movement.basic": {},
      "minecraft:jump.static": { "jump_power": 0.6 },
      "minecraft:navigation.walk": {
        "can_path_over_water": false,
        "avoid_water": true,
        "can_walk": true,
        "can_sink": false
      },
      "minecraft:physics": {},
      "minecraft:pushable": { "is_pushable": true, "is_pushable_by_piston": true },
      "minecraft:conditional_bandwidth_optimization": {},
      "minecraft:loot": {
        "table": "loot_tables/entities/deer.json"
      },
      "minecraft:despawn": {
        "despawn_from_distance": { "min_distance": 128, "max_distance": 128 }
      },
      "minecraft:behavior.float": {
        "priority": 0
      },
      "minecraft:behavior.panic": {
        "priority": 1,
        "speed_multiplier": 1.9
      },
      "minecraft:behavior.flee_sun": {
        "priority": 2,
        "speed_multiplier": 1.5
      },
      "minecraft:behavior.tempt": {
        "priority": 3,
        "speed_multiplier": 1.2,
        "items": ["minecraft:apple", "minecraft:golden_apple"],
        "within_radius": 10
      },
      "minecraft:behavior.breed": {
        "priority": 4,
        "speed_multiplier": 1.2
      },
      "minecraft:behavior.random_stroll": {
        "priority": 5,
        "speed_multiplier": 1.0
      },
      "minecraft:behavior.look_at_player": {
        "priority": 6,
        "look_distance": 8,
        "probability": 0.02
      },
      "minecraft:behavior.random_look_around": {
        "priority": 7
      },
      "minecraft:breedable": {
        "require_tame": false,
        "breeds_with": { "mate_type": "realism:deer", "breed_event": { "event": "minecraft:entity_born", "target": "self" } },
        "breed_items": ["minecraft:apple", "minecraft:golden_apple"]
      },
      "minecraft:ageable": {
        "duration": 1200,
        "grow_up": { "event": "minecraft:ageable_grow_up", "target": "self" },
        "feed_items": ["minecraft:apple", "minecraft:golden_apple"]
      },
      "minecraft:rideable": {
        "seat_count": 1,
        "family_types": ["player"],
        "seats": { "position": [0, 1.2, 0] }
      },
      "minecraft:leashable": {
        "soft_distance": 4,
        "hard_distance": 6,
        "max_distance": 10
      },
      "minecraft:sound_volume": 0.4,
      "minecraft:balloonable": {},
      "minecraft:fire_immune": false
    },
    "events": {
      "minecraft:entity_spawned": {
        "add": { "component_groups": ["realism:adult"] }
      },
      "minecraft:entity_born": {
        "add": { "component_groups": ["realism:baby"] }
      },
      "minecraft:ageable_grow_up": {
        "remove": { "component_groups": ["realism:baby"] },
        "add": { "component_groups": ["realism:adult"] }
      }
    },
    "component_groups": {
      "realism:baby": {
        "minecraft:is_baby": {},
        "minecraft:scale": { "value": 0.5 },
        "minecraft:collision_box": { "width": 0.45, "height": 0.7 },
        "minecraft:behavior.follow_parent": {
          "priority": 0,
          "speed_multiplier": 1.1,
          "max_distance": 24
        }
      },
      "realism:adult": {
        "minecraft:scale": { "value": 1.0 },
        "minecraft:collision_box": { "width": 0.9, "height": 1.4 }
      }
    }
  }
}
