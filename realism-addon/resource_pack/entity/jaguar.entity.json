{
  "format_version": "1.10.0",
  "minecraft:client_entity": {
    "description": {
      "identifier": "realism:jaguar",
      "materials": { "default": "entity_alphatest" },
      "textures": { "default": "textures/entity/jaguar" },
      "geometry": { "default": "geometry.realism.jaguar" },
      "animations": {
        "walk": "animation.realism.jaguar.walk",
        "run": "animation.realism.jaguar.run",
        "look_at_target": "animation.realism.jaguar.look_at_target"
      },
      "scripts": {
        "pre_animation": [
          "variable.leg_phase = query.mod(query.anim_time, 2.0) * 180;"
        ],
        "animate": [
          { "walk": "query.is_moving && !query.is_sprinting" },
          { "run": "query.is_moving && query.is_sprinting" },
          "look_at_target"
        ]
      },
      "animation_controllers": [
        { "general": "controller.animation.realism.jaguar" }
      ],
      "render_controllers": ["controller.render.default"],
      "spawn_egg": {
        "base_color": "#C89B3C",
        "overlay_color": "#2A1B0A"
      }
    }
  }
}
