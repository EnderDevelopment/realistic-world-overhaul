{
  "format_version": "1.10.0",
  "minecraft:client_entity": {
    "description": {
      "identifier": "realism:deer",
      "materials": { "default": "entity_alphatest" },
      "textures": { "default": "textures/entity/deer" },
      "geometry": { "default": "geometry.realism.deer" },
      "animations": {
        "walk": "animation.realism.deer.walk",
        "run": "animation.realism.deer.run",
        "look_at_target": "animation.realism.deer.look_at_target"
      },
      "scripts": {
        "pre_animation": [
          "variable.leg_phase = query.mod(query.anim_time, 2.0) * 180;"
        ],
        "animate": [
          { "walk": "query.is_moving && !query.is_sprinting" },
          { "run": "query.is_moving && query.is_sprinting" },
          "look_at_target"
        ]
      },
      "animation_controllers": [
        { "general": "controller.animation.realism.deer" }
      ],
      "render_controllers": ["controller.render.default"],
      "spawn_egg": {
        "base_color": "#8B5A2B",
        "overlay_color": "#D2B48C"
      }
    }
  }
}
